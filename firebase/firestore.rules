rules_version = '2';

// PendejosUnite - Firestore Security Rules (Production)
// These rules allow read/write only on the specific collections we use.

service cloud.firestore {
  match /databases/{database}/documents {

    // Chat messages
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Media posts
    match /media/{mediaId} {
      allow read, write: if true;
    }

    // Presence/online status
    match /presence/{userId} {
      allow read, write: if true;
    }

    // Pinboard
    match /pins/{pinId} {
      allow read, write: if true;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
