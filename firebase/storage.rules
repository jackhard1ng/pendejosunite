rules_version = '2';

// PendejosUnite - Firebase Storage Security Rules

service firebase.storage {
  match /b/{bucket}/o {
    // Media uploads - allow read and write for media folder
    match /media/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 50 * 1024 * 1024; // Max 50MB per file
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
