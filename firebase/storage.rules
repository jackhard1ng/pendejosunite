rules_version = '2';

// PendejosUnite - Firebase Storage Security Rules (Production)

service firebase.storage {
  match /b/{bucket}/o {
    // Media uploads
    match /media/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 50 * 1024 * 1024; // Max 50MB
    }

    // Pinboard photo uploads
    match /pins/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 50 * 1024 * 1024; // Max 50MB
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
