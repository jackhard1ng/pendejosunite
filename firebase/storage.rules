rules_version = '2';

// PendejosUnite - Firebase Storage Security Rules (Production)

service firebase.storage {
  match /b/{bucket}/o {
    // All uploads (media, audio, chat photos/videos, pins)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 50 * 1024 * 1024; // Max 50MB
    }
  }
}
